# Placeholder env file (DO NOT COMMIT REAL SECRETS)
#
# This repo uses:
# - Vite env vars in client/.env.* (must start with VITE_)
# - ASP.NET Core env vars (read automatically by .NET)
#
# You can copy these into your shell environment or into Docker compose env settings.

# ---- Backend SMTP (used by ContactService) ----
SMTP__HOST=smtp.gmail.com
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__TO=

